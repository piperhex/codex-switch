{
  "name": "@codex-switch/native",
  "version": "1.4.24",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "node ./scripts/expo.cjs start",
    "android": "node ./scripts/expo.cjs start --android",
    "ios": "node ./scripts/expo.cjs start --ios",
    "export:android": "node ./scripts/expo.cjs export --platform android --output-dir node_modules/.expo-export",
    "prebuild:android": "node ./scripts/expo.cjs prebuild --platform android --clean --no-install",
    "build:apk": "node ./scripts/build-apk.cjs",
    "prebuild:ios": "node ./scripts/expo.cjs prebuild --platform ios --clean --no-install",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^12.0.0",
    "@expo/vector-icons": "^14.1.0",
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "expo": "^53.0.0",
    "expo-application": "~6.1.4",
    "expo-asset": "~11.1.7",
    "expo-camera": "~16.1.11",
    "expo-clipboard": "~7.1.5",
    "expo-crypto": "~14.1.5",
    "expo-document-picker": "~13.1.6",
    "expo-file-system": "~18.1.11",
    "expo-font": "~13.3.2",
    "expo-image-manipulator": "~13.1.7",
    "expo-image-picker": "~16.1.4",
    "expo-notifications": "^0.31.5",
    "expo-secure-store": "~14.2.0",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.11",
    "markdown-it": "^15.0.1",
    "react": "19.0.0",
    "react-native": "0.79.5",
    "react-native-blob-util": "^0.24.10",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-webrtc": "^124.0.8",
    "react-native-webview": "13.13.5"
  },
  "devDependencies": {
    "@types/react": "~19.0.10",
    "typescript": "~5.8.3",
    "vitest": "^4.1.9"
  }
}

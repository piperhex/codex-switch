{
  "manifest_version": 3,
  "name": "Codex Switch 浏览器助手",
  "version": "1.1.0",
  "description": "让 Codex Switch 在你允许的网站上查看和操作 Chrome，无需安装 ChatGPT。",
  "minimum_chrome_version": "125",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "debugger",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Codex Switch 浏览器助手"
  },
  "icons": {
    "128": "icon.png"
  }
}

<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <?if $(sys.BUILDARCH)="x64"?>
    <?define HelperTarget="x86_64-pc-windows-msvc" ?>
  <?elseif $(sys.BUILDARCH)="arm64"?>
    <?define HelperTarget="aarch64-pc-windows-msvc" ?>
  <?else?>
    <?define HelperTarget="i686-pc-windows-msvc" ?>
  <?endif?>
  <Fragment>
    <!-- Referencing this feature retains the fragment and its custom actions in Tauri's MSI. -->
    <Feature Id="CswInstallerLifecycle" Title="Application lifecycle" Level="1" Display="hidden" />
    <Binary Id="CswInstallerHelper"
      SourceFile="$(sys.SOURCEFILEDIR)..\installer-helper\target\$(var.HelperTarget)\release\csw-installer-helper.exe" />
    <!-- Run before Restart Manager/file validation, in the invoking user's context.
         The embedded helper also supports old versions without cooperative shutdown. -->
    <CustomAction Id="CswStopForInstall" BinaryKey="CswInstallerHelper"
      ExeCommand='stop "[INSTALLDIR]csw.exe"' Return="check" Execute="immediate" />
    <CustomAction Id="CswFinishInstall" BinaryKey="CswInstallerHelper"
      ExeCommand='finish "[INSTALLDIR]csw.exe"' Return="check" Execute="immediate" />
    <CustomAction Id="CswCancelInstall" BinaryKey="CswInstallerHelper"
      ExeCommand='finish "[INSTALLDIR]csw.exe"' Return="ignore" Execute="immediate" />
    <CustomAction Id="CswFailedInstall" BinaryKey="CswInstallerHelper"
      ExeCommand='finish "[INSTALLDIR]csw.exe"' Return="ignore" Execute="immediate" />
    <InstallExecuteSequence>
      <Custom Action="CswStopForInstall" Before="InstallValidate">NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="CswFinishInstall" After="InstallFinalize">NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="CswCancelInstall" OnExit="cancel">NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="CswFailedInstall" OnExit="error">NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>
  </Fragment>
</Wix>

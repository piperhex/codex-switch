FROM node:22-alpine AS ui
WORKDIR /source
ARG NPM_REGISTRY=https://registry.npmmirror.com
COPY package.json package-lock.json ./
COPY apps/admin-ui/package.json ./apps/admin-ui/
RUN --mount=type=cache,target=/root/.npm npm ci --workspace @codex-switch/admin-ui \
    --ignore-scripts --no-audit --no-fund --registry=$NPM_REGISTRY
COPY apps/admin-ui ./apps/admin-ui
COPY shared ./shared
RUN npm run build --workspace @codex-switch/admin-ui

FROM node:22-alpine AS legacy
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/admin/package.json ./apps/admin/
RUN --mount=type=cache,target=/root/.npm npm ci --workspace @codex-switch/backend --ignore-scripts \
    --registry=https://registry.npmmirror.com --no-audit --no-fund
COPY apps/admin ./apps/admin
COPY shared ./shared
RUN npm run build --workspace @codex-switch/backend
COPY --from=ui /source/apps/admin-go/public ./apps/admin/public
WORKDIR /app/apps/admin
EXPOSE 8080
CMD ["node", "dist/main.js"]

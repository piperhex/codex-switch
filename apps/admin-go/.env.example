NODE_ENV=production
LISTEN_PORT=8080
PUBLIC_DIR=/app/public

# Keep the existing deployment's database and Redis values when migrating.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=codex_switch
POSTGRES_PASSWORD=
POSTGRES_DB=codex_switch
POSTGRES_SSLMODE=disable
POSTGRES_DB_SYNCHRONIZE=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Copy all three values unchanged from the existing deployment.
KONG_JWT_KEY=codex-switch
KONG_JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
REFRESH_TOKEN_TTL_SECONDS=2592000

CHAT_STUN_PORT=3478
CHAT_STUN_BIND=0.0.0.0
CHAT_STUN_URLS=
CODEX_OAUTH_ISSUER=https://auth.openai.com
CODEX_OAUTH_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
# Match the original deployment's effective proxy; leave empty for a direct connection.
CODEX_OUTBOUND_PROXY=http://host.docker.internal:7890

mail__transport=SMTP
mail__options__host=
mail__options__port=465
mail__options__secure=true
mail__options__auth__user=
mail__options__auth__pass=
mail__from=

# Use the existing PostgreSQL/Redis network: <legacy Compose project>_backend-internal.
# ADMIN_GO_NETWORK remains a fallback when ADMIN_GO_DB_NETWORK is unset.
ADMIN_GO_DB_NETWORK=admin_backend-internal
ADMIN_GO_KONG_NETWORK=kong-net
# Keep a distinct alias while the original backend is running; switch Kong explicitly.
ADMIN_GO_KONG_ALIAS=codex-switch-admin-go
ADMIN_GO_BIND=127.0.0.1
ADMIN_GO_PORT=8080
# Production STUN binding. While the original backend runs, override these with
# 127.0.0.1 and 3479 as shown in MIGRATION.md, then restore the public binding.
ADMIN_GO_STUN_BIND=0.0.0.0
ADMIN_GO_STUN_PORT=3478

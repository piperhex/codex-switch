NODE_ENV=production
LISTEN_PORT=8080
PUBLIC_DIR=/app/public

# Keep the existing deployment's database and Redis values when migrating.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=codex_switch
POSTGRES_PASSWORD=
POSTGRES_DB=codex_switch
POSTGRES_SSLMODE=disable
POSTGRES_DB_SYNCHRONIZE=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Existing installation: preserve all three values. New installation: generate independent random secrets.
KONG_JWT_KEY=codex-switch
KONG_JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
REFRESH_TOKEN_TTL_SECONDS=2592000

CHAT_STUN_PORT=3478
CHAT_STUN_BIND=0.0.0.0
CHAT_STUN_URLS=
CODEX_OAUTH_ISSUER=https://auth.openai.com
CODEX_OAUTH_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
# Match the original deployment's effective proxy; leave empty for a direct connection.
CODEX_OUTBOUND_PROXY=http://host.docker.internal:7890

mail__transport=SMTP
mail__options__host=
mail__options__port=465
mail__options__secure=true
mail__options__auth__user=
mail__options__auth__pass=
mail__from=

# Existing installation: retain its PostgreSQL/Redis network. New installation: create this network first.
# ADMIN_GO_NETWORK remains a fallback when ADMIN_GO_DB_NETWORK is unset.
ADMIN_GO_DB_NETWORK=codex-switch-data
ADMIN_GO_KONG_NETWORK=kong-net
# Match the live Kong upstream; preserve existing custom aliases and Compose overrides.
ADMIN_GO_KONG_ALIAS=codex-switch-admin-go
ADMIN_GO_BIND=127.0.0.1
ADMIN_GO_PORT=8080
# Public STUN binding must match CHAT_STUN_URLS and the host firewall.
ADMIN_GO_STUN_BIND=0.0.0.0
ADMIN_GO_STUN_PORT=3478

# Pin this to the locally built and uploaded image tag when releasing.
ADMIN_GO_IMAGE=codex-switch/admin-go:local
# Used only by compose.infrastructure.yml for a new installation.
ADMIN_GO_POSTGRES_DATA=/srv/codex-switch/postgres
